/_to_delete/
/_export/
*.tgz
*.tar.gz

# ad-hoc in-tree git worktrees (should live outside the repo, ignored if created here)
/.pb2-followup-wt/

# generated Playwright auth storageState (live session cookies) — never commit
/e2e/.auth/

# raw owner-supplied image exports (ChatGPT PNGs, ~30MB) — never web-served;
# only the selected/converted WebP files under public/landing/ are tracked.
# asset-map.json (file -> section -> use/hold/flagged/reference) is the one
# exception — it's the deterministic spec for that conversion and is meant
# to be committed and diffed.
/brand/images/*
!/brand/images/asset-map.json

graphify-out/

# session WIP — reconstructed g3 blueprints + review artifacts, keep local, do not publish
content/question-factory/blueprints/g3-reading-comprehension-001.json
content/question-factory/blueprints/g3-language-conventions-001.json
content/question-factory/reports/review-packs-2026-07-25/
content/question-factory/reports/review-responses-2026-07-25/
content/question-factory/reports/restore-review-report-2026-07-25.json
content/question-factory/reports/_packet-data-2026-07-25.json

# Playwright trace/repro artefacts from local debugging runs — regenerated on
# demand by `npx playwright show-trace`, never durable project history.
/trace-repro/

# Local Claude Code plugin lockfile — machine-specific, not project config.
/skills-lock.json

# Machine-specific graphify config, points at gitignored graphify-out/.
/CLAUDE.md

# Per-child exam reports rendered from live attempt data for inspection.
# These contain a real child's prompts, answers and scores — response data
# that must never enter git history, where removing it later means a
# history rewrite. The rest of docs/reports/ stays tracked. Nothing
# regenerates from git: the generator reads the database directly.
#
# These patterns are a backstop, NOT the control. They match on filename,
# and filenames are chosen by whoever writes the file — the first version of
# this list named two children explicitly, and a differently-named report
# rendered from the same database went straight past it and into a commit,
# carrying three children's login codes (the username half of their
# code + PIN credentials) toward a public push. It was caught by reading the
# outgoing diff, not by this file.
#
# So: anything rendered from live user data gets read before it is staged,
# whatever it is called. Identifiers — names, login codes, alias emails —
# are replaced with placeholders before such a document is committed.
/docs/reports/*-attempts-*.md
/docs/reports/*-responses-*.md
/docs/reports/*child-data*
