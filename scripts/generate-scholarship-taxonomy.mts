/**
 * Generates src/features/question-factory/taxonomy/scholarship-entries.ts from the
 * skills the Year 6 scholarship drafts actually declare, so the governed taxonomy
 * registry resolves every draft skill (the draft id is kept as an alias).
 */
import { readFileSync, writeFileSync } from "node:fs";

const files = ["numerical-reasoning", "verbal-reasoning", "reading", "mathematics"];
const seen = new Map<string, { strand: string; subject: string; type: string }>();
for (const f of files) {
  const d = JSON.parse(readFileSync(`content/scholarship-drafts/scholarship-y6-${f}-draft.json`, "utf8"));
  for (const q of d.questions) {
    const prev = seen.get(q.metadata.skill);
    if (prev && (prev.strand !== q.metadata.strand || prev.subject !== q.metadata.subject)) throw new Error(`Skill ${q.metadata.skill} spans strands/subjects`);
    seen.set(q.metadata.skill, { strand: q.metadata.strand, subject: q.metadata.subject, type: q.type });
  }
}
const title = (id: string) => id.replace(/^[a-z]+-/, "").split("-").map((w, i) => (i === 0 ? w[0].toUpperCase() + w.slice(1) : w)).join(" ");
const entries = [...seen.entries()].sort(([a], [b]) => a.localeCompare(b)).map(([skill, v]) => ({
  id: `scholarship.${skill}`,
  displayName: `${title(skill)} (scholarship-style)`,
  aliases: [skill],
  yearLevels: [6],
  examStyles: ["scholarship_style"],
  subject: v.subject,
  strand: v.strand,
  prerequisites: [],
  recommendedQuestionTypes: [v.type],
  recommendedVisualTypes: [],
  supportedDifficulties: ["easy", "medium", "challenging"],
  curriculumNotes: ["Scholarship-style Year 6 reasoning skill; original practice content, not an official Edutest or ACER question. Difficulty requires item-level calibration."],
  generationConstraints: ["Independently verify the answer and age appropriateness before publication."],
}));
writeFileSync("src/features/question-factory/taxonomy/scholarship-entries.ts",
  `import type { TaxonomyEntry } from "./types";\n\n/** Generated by scripts/generate-scholarship-taxonomy.mts from the Year 6 scholarship drafts. */\nexport const SCHOLARSHIP_SKILL_TAXONOMY_ENTRIES: readonly TaxonomyEntry[] = ${JSON.stringify(entries, null, 2)} as unknown as readonly TaxonomyEntry[];\n`);
console.log(`${entries.length} skills written`);
